# Cloudflare Pages Redirect & Static Pass-Through Rules
# Note: Pre-rendered static files in dist/ (including /product/*/index.html, /llms.txt, /sitemap.xml)
# are served natively before fallback rules.

/api/*              /api/:splat              200
/assets/*           /assets/:splat           200
/product-image/*    /product-image/:splat    200
/banners/*          /banners/:splat          200
/audio/*            /audio/:splat            200
/blog-thumbnail/*   /blog-thumbnail/:splat   200
/llms.txt           /llms.txt                200
/llms-full.txt      /llms-full.txt           200
/robots.txt         /robots.txt              200
/sitemap.xml        /sitemap.xml             200

# SPA Fallback for dynamic client-side routes
/*                  /index.html              200
